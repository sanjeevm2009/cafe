# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Admin Bootstrap Passcode (server-side only).
# If unset, the first admin can be claimed via the one-time setup form at /admin/login.
ADMIN_BOOTSTRAP_PASSCODE=

# Stripe Payment Gateway (server-side secret + webhook secret + public publishable key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# SMTP Email Notifications (server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MAISON CRUMB <bonjour@maisoncrumb.fr>"
ADMIN_NOTIFICATION_EMAIL="atelier@maisoncrumb.fr"
